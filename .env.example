# Copy to `.env` (same directory as docker-compose.yml) on the VPS.
# NEXT_PUBLIC_* values are baked into the client bundle at build time — rebuild after changing them.

# Backend API URL used by the browser (and usually by SSR too)
NEXT_PUBLIC_BACKEND_URL_FOR_CLIENT_REQUESTS=https://api.treadx.uqarsoft.com/api
NEXT_PUBLIC_BACKEND_URL_FOR_SERVER_REQUESTS=https://api.treadx.uqarsoft.com/api

# Host port published by Docker (container always listens on 3000)
HOST_PORT=3100
